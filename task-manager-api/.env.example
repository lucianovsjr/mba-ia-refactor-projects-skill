# Copie para .env (carregado automaticamente) ou exporte no ambiente.
# Nenhum valor abaixo é segredo real.

# Obrigatória em produção; sem ela, uma chave aleatória é gerada a cada boot
# e os tokens de login (assinados com ela) deixam de valer a cada restart.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# SQLite relativo fica em instance/tasks.db
DATABASE_URL=sqlite:///tasks.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
