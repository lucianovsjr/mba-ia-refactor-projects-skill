# Copie para o ambiente (export ...) ou para o seu gerenciador de variáveis.
# Nenhum valor abaixo é segredo real.

# Obrigatória em produção; sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
APP_ENV=development
DATABASE_PATH=loja.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Endpoints administrativos (POST /admin/reset-db). Desligados por padrão.
ENABLE_ADMIN_ENDPOINTS=false
ADMIN_TOKEN=
